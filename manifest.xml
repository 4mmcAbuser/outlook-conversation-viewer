<?xml version="1.0" encoding="utf-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appshere/manifest/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailapp="http://schemas.microsoft.com/office/mailappversionoverrides"
           xmlns:mailapp1_1="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
           xsi:type="MailApp">
  <Id>8d2f1f50-32df-4277-bc60-0a370e5b565d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Premium Add-ins Corp</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Conversation JSON Viewer" />
  <Description DefaultValue="Extracts, analyzes, and displays the complete email conversation thread as an interactive JSON structure inside a glassmorphic panel." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-128.png" />
  
  <SupportUrl DefaultValue="https://github.com/github/outlook-conversation-viewer" />
  
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3" />
    </Sets>
  </Requirements>
  
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  
  <Permissions>ReadWriteMailbox</Permissions>
  
  <Rule xsi:type="RuleCollection" Mode="And">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
    <Description resid="AppDescription" />
    <Requirements>
      <Sets>
        <Set Name="Mailbox" MinVersion="1.5" />
      </Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabReadMessage">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="ViewConversationButton">
                  <Label resid="ButtonLabel" />
                  <Supertip>
                    <Title resid="ButtonTitle" />
                    <Description resid="ButtonDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="TaskPane.Url" />
                    <SupportPinning>true</SupportPinning>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
        <bt:Url id="TaskPane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:ShortString id="GroupLabel" DefaultValue="Conversation JSON" />
        <bt:ShortString id="ButtonLabel" DefaultValue="View Conversation JSON" />
        <bt:ShortString id="ButtonTitle" DefaultValue="View Conversation Thread Details" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:LongString id="AppDescription" DefaultValue="A premium developer add-in to inspect entire Outlook conversation history as structured JSON." />
        <bt:LongString id="ButtonDesc" DefaultValue="Fetches the complete historical email conversation thread and parses it into a collapsible, interactive JSON viewer." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
